{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "emielster.dev" }],
      "destination": "https://www.emielster.dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/mindify/v1/:path*",
      "destination": "/api/mindify/v1/[...route]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}